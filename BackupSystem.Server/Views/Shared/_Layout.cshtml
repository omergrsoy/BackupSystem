<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Yedekleme Sistemi</title>

    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/forms-buttons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>

    <div class="app-wrapper">

        <nav class="sidebar">
            <a asp-controller="Home" asp-action="Index" class="sidebar-brand">
                ⚙️ Yedekleme Sistemi
            </a>

            <ul class="sidebar-menu">
                <li>
                    <a asp-controller="Machines" asp-action="Index">💻 Makineler</a>
                </li>
                <li>
                    <a asp-controller="Backups" asp-action="Index">📦 Geçmiş Yedekler</a>
                </li>
                <li>
                    <a href="#">⏱️ Zamanlanmış Görevler</a>
                </li>
                <li>
                    <a href="#">⚙️ Ayarlar</a>
                </li>
            </ul>
        </nav>

        <main class="main-content">
            @RenderBody()
        </main>

    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>