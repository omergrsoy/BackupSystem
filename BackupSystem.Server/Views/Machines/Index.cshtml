@model IEnumerable<BackupSystem.Server.Models.Machine>

@{
    ViewData["Title"] = "Makineler";
}

<div class="machine-container">
    <div class="machine-header">
        <h2>Kayıtlı Makineler</h2>
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success" style="background-color:#d1e7dd; color:#0f5132; padding:10px; border-radius:5px; margin-bottom:15px;">
                @TempData["Message"]
            </div>
        }
        <a asp-action="Create" class="btn-custom btn-primary-custom">Yeni Makine Ekle</a>
    </div>

    <table class="machine-table">
        <thead>
            <tr>
                <th>Makine Adı</th>
                <th>IP Adresi</th>
                <th>İşletim Sistemi</th>
                <th>Hedef Dizin</th>
                <th>Durum</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.IpAddress</td>
                    <td>@item.OSType</td>
                    <td>@item.TargetDirectory</td>
                    <td>
                        @if (item.IsActive)
                        {

                            if ((DateTime.Now - item.LastHeartbeat).TotalMinutes > 5)
                            {
                                <span class="badge-custom badge-warning">Çevrimdışı</span>
                            }
                            else
                            {
                                <span class="badge-custom badge-active">Çevrimiçi</span>
                            }
                        }
                        else
                        {
                            <span class="badge-custom badge-passive">Pasif</span>
                        }
                    </td>
                    <td>
                        <div class="dropdown" style="display:inline-block; margin-right:4px;">
                            <button class="btn-custom btn-sm-custom btn-success-custom dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Yedekle
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-action="RequestBackup" asp-route-id="@item.Id" asp-route-type="Tam">Tam Yedek (Full)</a></li>
                                <li><a class="dropdown-item" asp-action="RequestBackup" asp-route-id="@item.Id" asp-route-type="Artımlı">Artımlı (Incremental)</a></li>
                                <li><a class="dropdown-item" asp-action="RequestBackup" asp-route-id="@item.Id" asp-route-type="Fark">Fark (Differential)</a></li>
                            </ul>
                        </div>

                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-custom btn-sm-custom btn-warning-custom">Düzenle</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-custom btn-sm-custom btn-danger-custom" onclick="return confirm('Bu makineyi silmek istediğinize emin misiniz?');">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>